# PostgreSQL connection string (Neon, or any Postgres)
# Neon: https://neon.tech → create project → copy connection string
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"
DATABASE_SSL="true" # "true" for remote Postgres (rejectUnauthorized:false)

# ── NextAuth v5 (Auth.js) ─────────────────────────────────────────────────────
# v5 reads AUTH_SECRET automatically. Generate with: openssl rand -base64 32
AUTH_SECRET="run: openssl rand -base64 32"
# Behind a proxy in prod, also set: AUTH_TRUST_HOST=true

# Google OAuth — https://console.cloud.google.com → APIs & Services → Credentials
# Authorized redirect URI: https://YOUR_DOMAIN/api/auth/callback/google
#                          (local: http://localhost:3002/api/auth/callback/google)
GOOGLE_CLIENT_ID="xxx.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="GOCSPX-xxx"

# Restrict login to a single owner email (fail-closed if unset).
# OWNER_EMAIL is preferred; ALLOWED_EMAIL is accepted as a fallback.
OWNER_EMAIL="your@email.com"

# Legacy owner UUID used as sequences.user_id so existing rows keep resolving.
# Find it once via: SELECT DISTINCT user_id FROM sequences;
OWNER_USER_ID="00000000-0000-0000-0000-000000000000"

# Secret token for the AI sequence creation API (POST /api/ai/sequences) and
# Bearer-authorized script access. Generate with: openssl rand -base64 32
SEQUENCES_API_SECRET="your-secret-token-here"

# Anthropic key for POST /api/ai/generate
ANTHROPIC_API_KEY="sk-ant-..."

# Public base URL used to build absolute links in AI-generated payloads and API responses.
NEXT_PUBLIC_APP_URL="https://sequences-bheng.vercel.app"

# Public site URL used for metadata/OpenGraph tags (app/layout.tsx).
NEXT_PUBLIC_SITE_URL="https://sequences-bheng.vercel.app"

# DEV-ONLY auth bypass that treats the request as the owner without signing in. NEVER set this in production.
# Leave unset/commented by default - only uncomment for local troubleshooting.
# LOCAL_DEV="true"
